{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      "@electron/*": ["./electron/*"],
      "@test/*": ["./tests/unit/*"]
    },
    "declaration": true,
    "declarationDir": "./node_modules/.tmp/vitest-types",
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "references": [
    { "path": "./tsconfig.app.json" }
  ],
  "include": [
    "env.d.ts",
    "components.d.ts",
    "auto-imports.d.ts",
    "typed-router.d.ts",
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "electron/**/*.spec.ts",
    "shared/**/*.spec.ts",
    "tests/unit/**/*",
    "tests/contract/**/*"
  ],
  "exclude": []
}
