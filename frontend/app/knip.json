{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/pages/**/*.vue!",
    "index.html!",
    "electron/main/index.ts!",
    "electron/preload/index.ts!",
    "electron/preload/wallet-bridge.ts!",
    ".electron-builder.config.ts",
    "vite.config.main.ts",
    "vite.config.preload.ts",
    "scripts/**/*.{ts,js}",
    "src/**/*.{spec,test}.ts",
    "electron/**/*.{spec,test}.ts",
    "shared/**/*.{spec,test}.ts",
    "tests/unit/setup-files/**/*.{ts,js}",
    "tests/e2e/specs/**/*.{ts,js}"
  ],
  "project": [
    "src/**/*.{ts,vue}",
    "electron/**/*.ts",
    "shared/**/*.ts",
    "tests/unit/**/*.ts"
  ],
  "ignoreDependencies": [
    "@fontsource/roboto",
    "@fontsource/roboto-mono",
    "@vueuse/math"
  ],
  "ignoreBinaries": [
    "uv",
    "xdg-mime"
  ],
  "tags": ["-@public"],
  "paths": {
    "@/*": ["src/*"],
    "@shared/*": ["shared/*"],
    "@electron/*": ["electron/*"],
    "@test/*": ["tests/unit/*"]
  }
}
