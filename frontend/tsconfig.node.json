{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.frontend.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "scripts/**/*",
    "app/shared/cargo-env.ts",
    "app/shared/ipc.ts",
    "app/shared/starling/**/*"
  ]
}
