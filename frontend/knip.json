{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    "common",
    "dev-proxy"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,js}"],
      "project": ["scripts/**/*.{ts,js}"],
      "ignoreDependencies": [
        "flag-icons",
        "@tsconfig/node24",
        "@rotki/ui-library"
      ],
      "ignoreBinaries": ["tsx", "stylelint"]
    },
    "app": {
      "entry": [
        "src/pages/**/*.vue!",
        "index.html!",
        "electron/main/index.ts!",
        "electron/preload/index.ts!",
        "electron/preload/wallet-bridge.ts!",
        ".electron-builder.config.ts",
        "vite.config.main.ts",
        "vite.config.preload.ts",
        "scripts/**/*.{ts,js}",
        "src/**/*.{spec,test}.ts",
        "electron/**/*.{spec,test}.ts",
        "shared/**/*.{spec,test}.ts",
        "tests/unit/setup-files/**/*.{ts,js}",
        "tests/e2e/specs/**/*.{ts,js}"
      ],
      "project": [
        "src/**/*.{ts,vue}",
        "electron/**/*.ts",
        "shared/**/*.ts",
        "tests/unit/**/*.ts"
      ],
      "ignoreDependencies": [
        "@fontsource/roboto",
        "@fontsource/roboto-mono",
        "@vueuse/math",
        "dmg-license"
      ],
      "ignoreBinaries": ["uv", "xdg-mime", "report", "ss"],
      "paths": {
        "@/*": ["src/*"],
        "@shared/*": ["shared/*"],
        "@electron/*": ["electron/*"],
        "@test/*": ["tests/unit/*"]
      }
    }
  },
  "tags": ["-@public"]
}
